# 기본: git이 텍스트 파일을 알아서 판단하고, 저장소에는 LF로 통일
* text=auto eol=lf

# 코드·설정·문서는 명시적으로 LF
*.py    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows 전용 스크립트는 CRLF여야 제대로 돌아감
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 바이너리: 절대 건드리지 마
*.png   binary
*.jpg   binary
*.pdf   binary
*.xlsx  binary
